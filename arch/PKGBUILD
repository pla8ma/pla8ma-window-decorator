# Maintainer: n0x073 <72650981+n0x073@users.noreply.github.com>

_pkgname=pla8ma-window-decorator
pkgname=${_pkgname}-git
pkgver=1.0.1.r5.gbebd093
pkgrel=1
pkgdesc='Flat KWin window decoration that follows the Plasma color scheme'
arch=('x86_64' 'aarch64')
url='https://github.com/pla8ma/pla8ma-window-decorator'
license=('GPL-2.0-only OR GPL-3.0-only OR LicenseRef-scancode-kde-accepted-gpl' 'GPL-2.0-or-later' 'MIT')
depends=(
    'glibc'
    'kcmutils'
    'kconfig'
    'kcoreaddons'
    'kdecoration'
    'kguiaddons'
    'ki18n'
    'kwidgetsaddons'
    'kwin'
    'libstdc++'
    'qt6-base'
)
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'gettext'
    'git'
    'kcolorscheme'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${_pkgname}"
    local version
    version=$(sed -n 's/^project([^ ]* VERSION \([0-9.]*\)).*/\1/p' CMakeLists.txt)
    printf '%s.r%s.g%s' "${version}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cmake -B build -S "${_pkgname}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=None \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" "${_pkgname}"/LICENSES/*
}
